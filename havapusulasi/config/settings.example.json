{
  "version": 1,
  "note": "Belgeleme örneğidir; uygulamaya otomatik aktarılmaz. Ayarları ekrandan seçin.",
  "theme": "system",
  "units": {
    "temperature": "celsius",
    "wind": "km/h",
    "precipitation": "mm"
  },
  "max_cities": 12,
  "notifications": {
    "enabled": false,
    "hour": 8,
    "minute": 0,
    "timezone": "device",
    "scope": "all_saved_cities"
  },
  "background_refresh": {
    "enabled": false,
    "network": "unmetered",
    "interval_minutes": 30,
    "available_intervals_minutes": [
      30,
      60,
      180
    ],
    "max_cities_per_run": 12,
    "stop_after_consecutive_failures": 2,
    "enabled_with_widgets_unless_explicitly_disabled": true
  },
  "widgets": {
    "city_per_widget": true,
    "follow_app_city": true,
    "cache_display_interval_minutes": 30,
    "last_update_format": "HH:mm (device timezone; date added for previous days)",
    "feels_like": true,
    "wind": true,
    "humidity": true,
    "future_days_limit": 6,
    "future_days_per_page": 3,
    "recommended_size_dp": {
      "width": 300,
      "height": 430
    },
    "daily_forecast_min_height_dp": 420,
    "footer_buttons": false,
    "card_height": "wrap_content"
  },
  "api_key_required": false
}
