<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_background">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
<TextView android:id="@+id/widget_city" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold" android:textColor="#EAF5F4" android:maxLines="1" android:ellipsize="end"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_brand" android:textSize="11sp" android:textColor="#76D2CF"/>
</LinearLayout>
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
<TextView android:id="@+id/widget_temperature" android:layout_width="wrap_content" android:layout_gravity="start|center_vertical" android:layout_height="wrap_content" android:textSize="44sp" android:textStyle="bold" android:textColor="#FFFFFF" android:maxLines="1"/>
<TextView android:id="@+id/widget_symbol" android:layout_gravity="end|center_vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="32sp" android:textColor="#F5CA7D" android:importantForAccessibility="no"/>
</FrameLayout>
<TextView android:id="@+id/widget_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#D0E7E8" android:maxLines="1" android:ellipsize="end"/>
<TextView android:id="@+id/widget_age" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#A6BDC5" android:maxLines="2" android:ellipsize="end"/>
<TextView android:id="@+id/widget_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#F5CA7D" android:maxLines="1" android:ellipsize="end"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal" android:gravity="center_vertical">
<TextView android:id="@+id/widget_open" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="@string/widget_open" android:textSize="12sp" android:textStyle="bold" android:textColor="#76D2CF"/>
<TextView android:id="@+id/widget_refresh" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="@string/widget_refresh" android:textSize="12sp" android:textStyle="bold" android:textColor="#76D2CF"/>
<TextView android:id="@+id/widget_configure" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="@string/widget_city" android:textSize="12sp" android:textStyle="bold" android:textColor="#76D2CF"/>
</LinearLayout>
</LinearLayout>
